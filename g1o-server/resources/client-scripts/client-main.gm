// Gothic 1 Online default client script.
//
// Commands handled here return 1 so they stay local. Any other slash command
// returns 0 and is sent to the server.

function onInit()
{
	addMessage(120, 220, 120, "Default client script loaded (language: " + getLanguage() + ").");
}

function onCommand(command, params)
{
	if (command == "ping")
	{
		addMessage(180, 220, 255, format("Ping: %d ms", getPing()));
		return 1;
	}

	if (command == "where")
	{
		local position = getPosition();
		addMessage(180, 220, 255, format("Position: %.2f, %.2f, %.2f", position.x, position.y, position.z));
		return 1;
	}

	return 0;
}

function onPacket(data) {}
function onRender() {}
function onClick(button, x, y, wheel) {}
function onKey(key, character) {}
function onHit() {}
function onDie() {}
function onRespawn() {}
function onUnconscious() {}
function onStandUp() {}
function onProgramName(windowTitle) { return 0; }
function onOpenInventory() {}
function onCloseInventory() {}
function onMobTrigger(name, x, y, z, type) { return 0; }
function onMobUntrigger(name, x, y, z, type) { return 0; }
function onUseItem(instance, amount, hand) {}
function onTakeFocus(id, name, x, y, z) {}
function onLostFocus(id, name) {}
function onRenderNickname(id, name, x, y) { return 0; }
