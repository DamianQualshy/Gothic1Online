// Gothic 1 Online default server script.
//
// This is intentionally small, but functional. It demonstrates the core
// callbacks and a few safe commands without imposing a game mode.

function onInit()
{
	print("[example] Default server script loaded");
}

function onJoin(playerId)
{
	local name = getPlayerName(playerId);
	sendMessageToAll(120, 220, 120, name + " joined the server.");
	sendMessage(playerId, 255, 210, 80, "Welcome! Type /help for example commands.");
}

function onDisconnect(playerId, reason)
{
	local name = getPlayerName(playerId);
	sendMessageToAll(220, 120, 120, name + " left the server (" + reason + ").");
}

function onCommand(playerId, command, params)
{
	if (command == "help")
	{
		sendMessage(playerId, 255, 210, 80, "/players - show the number of connected players");
		sendMessage(playerId, 255, 210, 80, "/position - show your server-side position");
	}
	else if (command == "players")
	{
		sendMessage(playerId, 180, 220, 255, format("Players: %d/%d", getPlayersCount(), getMaxSlots()));
	}
	else if (command == "position")
	{
		local position = getPosition(playerId);
		if (position)
			sendMessage(playerId, 180, 220, 255, format("Position: %.2f, %.2f, %.2f", position.x, position.y, position.z));
	}
}

// Return 0 to let the built-in chat broadcast the original message.
// Return 1 after broadcasting a custom replacement to suppress it.
function onMessage(playerId, message)
{
	return 0;
}

function onHit(playerId, targetId) {}
function onDie(playerId, killerId) {}
function onUnconscious(playerId, attackerId) {}
function onRespawn(playerId) {}
function onStandUp(playerId) {}
function onTake(playerId, itemId, instance, amount, world) {}
function onDrop(playerId, itemId, instance, amount, world) {}
function onTakeFocus(playerId, focusId) {}
function onLostFocus(playerId, focusId) {}
function onPacket(playerId, data) {}
function onAdminCommand(playerId, command) {}
function onTick() {}
